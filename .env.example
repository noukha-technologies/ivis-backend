# ================================
# Application Configuration
# ================================
NODE_ENV=development
PORT=3000
API_PREFIX=api/ivis/v1
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# ================================
# PostgreSQL Database Configuration
# ================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
POSTGRES_SSLMODE=disable

# ================================
# Database schemas
# ================================
# Tables use two Postgres schemas:
#   core   — users, user_sessions, and other operational data
#   master — roles and other reference / master data

# ================================
# Central DB Configuration (Master Database — Onboarding Sync)
# ================================
# NOT the "master" Postgres *schema* above — this is the separate central
# Master Database that holds every centre's data, used only on a fresh
# centre server's first login to sync its own centre-scoped master data.
# The credentials below MUST point at a READ-ONLY Postgres role: this
# connection is never written to.
CENTRAL_DB_HOST=localhost
CENTRAL_DB_PORT=5432
CENTRAL_DB_USER=your_readonly_central_db_user
CENTRAL_DB_PASSWORD=your_readonly_central_db_password
CENTRAL_DB_DB=your_central_db_name
CENTRAL_DB_SSLMODE=disable

# ================================
# JWT / Auth Configuration
# ================================
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRY_DAYS=7
REFRESH_TOKEN_ENCRYPT_KEY=change-me-encrypt-key-min-32-chars
RESET_TOKEN_SECRET=change-me-reset-secret-min-32-chars

# ================================
# ANPR — FTP Watcher
# ================================
ANPR_FTP_WATCH_MODE=poll
ANPR_FTP_WATCH_INTERVAL_MS=1000
ANPR_FTP_MOUNT_BASE=
ANPR_FTP_FALLBACK_SWEEP_MINUTES=5
ANPR_FTP_PROCESSED_STRATEGY=move
ANPR_FTP_INGEST_MODE=jpeg
ANPR_FTP_OCR_DEBUG=false

# ================================
# ANPR — Webhook (HTTP Push)
# ================================
ANPR_WEBHOOK_ALIASES=
ANPR_RAW_CAPTURE_DIR=./logs/anpr-webhook-raw
ANPR_DAY_TIMEZONE=Asia/Muscat
ANPR_DEBUG_DUMP_DIR=

# ================================
# ANPR — OCR
# ================================
ANPR_FTP_OCR_LANG=eng+ara
ANPR_FTP_MIN_CONFIDENCE=80

# ================================
# Online Appointment provider (third-party GET API)
# Looked up by plate on ANPR capture: a listed plate → Online appointment,
# otherwise the job is created as Walk-in. Leave URL blank to disable (all Walk-in).
# ================================
ONLINE_APPOINTMENT_API_URL=
ONLINE_APPOINTMENT_API_KEY=
