# ================================
# Application Configuration
# ================================
NODE_ENV=development
PORT=3000
API_PREFIX=api/ivis/v1
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# ================================
# PostgreSQL Database Configuration
# ================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
POSTGRES_SSLMODE=disable

# ================================
# Database schemas
# ================================
# Tables use two Postgres schemas:
#   core   — users, user_sessions, and other operational data
#   master — roles and other reference / master data

# ================================
# Node identity (Onboarding Sync — Super Admin re-scoping)
# ================================
# central = the Master server (Super Admins operate with real global scope —
#           NOT yet fully wireable; needs a writable central DB connection).
# centre  = an on-prem centre server (today's only real deployment).
NODE_ROLE=centre

# ================================
# Central Sync API (HTTPS-only — Onboarding Sync + Database Sync)
# ================================
# See Database_sync_arch_replan.md. Centre and central talk ONLY over
# HTTPS/JSON now — no direct Postgres connection between them, for either
# feature. CENTRE-ROLE deployments (NODE_ROLE=centre, the normal case) set
# both of these; a CENTRAL-ROLE deployment (NODE_ROLE=central) is the
# receiver and does not set them.
#
# CENTRAL_SYNC_API_URL: base URL of the central server's API (e.g.
# https://central.ivis.example.com/api). Used for Onboarding Sync's
# confirm/pull handshake (authenticated by the user's own login credentials,
# not this key) and every ongoing Database Sync run afterward.
#
# CENTRAL_SYNC_API_KEY: this centre's own API key, minted automatically by
# central and returned once at the end of Onboarding Sync's pull — copy it
# here after that completes. Used as a Bearer token on every /sync/run/*
# call. Not needed (and not yet issued) before this centre has onboarded.
CENTRAL_SYNC_API_URL=https://central.ivis.example.com/api
CENTRAL_SYNC_API_KEY=

# ================================
# JWT / Auth Configuration
# ================================
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRY_DAYS=7
REFRESH_TOKEN_ENCRYPT_KEY=change-me-encrypt-key-min-32-chars
RESET_TOKEN_SECRET=change-me-reset-secret-min-32-chars

# ================================
# ANPR — FTP Watcher
# ================================
ANPR_FTP_WATCH_MODE=poll
ANPR_FTP_WATCH_INTERVAL_MS=1000
ANPR_FTP_MOUNT_BASE=
ANPR_FTP_FALLBACK_SWEEP_MINUTES=5
ANPR_FTP_PROCESSED_STRATEGY=move
ANPR_FTP_INGEST_MODE=jpeg
ANPR_FTP_OCR_DEBUG=false

# ================================
# ANPR — Webhook (HTTP Push)
# ================================
ANPR_WEBHOOK_ALIASES=
ANPR_RAW_CAPTURE_DIR=./logs/anpr-webhook-raw
ANPR_DAY_TIMEZONE=Asia/Muscat
ANPR_DEBUG_DUMP_DIR=

# ================================
# ANPR — OCR
# ================================
ANPR_FTP_OCR_LANG=eng+ara
ANPR_FTP_MIN_CONFIDENCE=80

# ================================
# Online Appointment provider (third-party GET API)
# Looked up by plate on ANPR capture: a listed plate → Online appointment,
# otherwise the job is created as Walk-in. Leave URL blank to disable (all Walk-in).
# ================================
ONLINE_APPOINTMENT_API_URL=
ONLINE_APPOINTMENT_API_KEY=
