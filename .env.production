# ==============================================================================
# PRODUCTION — live centre deployment
#
# Loaded when NODE_ENV=production. `.env` is applied on top for host-specific
# overrides.
#
# Secrets are intentionally BLANK and MUST NOT be committed. Supply them via
# the deployment environment (container env vars, systemd, CI secrets) or an
# uncommitted `.env` on the host. Real environment variables always win over
# any file, so a container needs no env file at all.
#
# What changes versus development:
#   • Appointment provider points at the PRODUCTION host
#   • Every configured branch is writable — the non-production branch guard
#     is lifted, because live branches are exactly what this environment
#     should be talking to
#   • Swagger is disabled
# ==============================================================================

PORT=4780
NODE_ENV=production
# `centre` is the default because there are many centre boxes and only one
# central. The CENTRAL deployment must override this to `central` in its own
# hosting environment (Render dashboard → Environment), NOT by editing this
# file — dotenv never overwrites a real environment variable, so the dashboard
# value wins and every centre keeps the default.
#
# Getting this wrong on central is not fatal but is visibly wasteful: it runs
# FTP watchers for cameras it cannot reach and health-checks 192.168.x
# addresses it cannot route to.
NODE_ROLE=centre
API_PREFIX=api/ivis-backend-service/v1

# Explicit allowlist — required, since any-origin is never enabled here.
CORS_ORIGINS=

# ==================== Database ====================
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=centre_database
POSTGRES_SSLMODE=require

# ==================== Central sync ====================
CENTRAL_SYNC_API_URL=
CENTRAL_SYNC_API_KEY=

# ==================== External providers ====================
ROP_API_URL=
ROP_API_KEY=

ONLINE_APPOINTMENT_API_URL=
ONLINE_APPOINTMENT_API_KEY=

PAYMENT_API_URL=
PAYMENT_API_KEY=

# ==================== Auth ====================
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRY_DAYS=7
REFRESH_TOKEN_ENCRYPT_KEY=
RESET_TOKEN_SECRET=

# ==================== Appointment provider (Tajdeed VIS) ====================
# Production host and the PRODUCTION global key, which the provider issues
# separately from the staging one. Valid for every branch, so a new centre
# needs no new key. Server-side only: it must never reach the admin panel.
#
# ⚠ LEAVE THE KEY EMPTY ON THE CENTRAL DEPLOYMENT.
# Central has no lane and no branch of its own, so it has nothing legitimate to
# send. It is pointed at the PRODUCTION provider with every branch writable, so
# a key filled in "to clear the warnings" would let a shared server push lane
# and inspection events into live branches. The centre-only guards stop the
# schedulers from running there; this stays empty as the second line of defence.
APPOINTMENT_API_BASE_URL=https://tajdeed.com.om/api/v1/vis
APPOINTMENT_API_KEY=

# Ignored in production: every configured branch is legitimate here.
