# dotenv environment variable files
#
# Per-environment templates (.env.staging / .env.production) are committed with
# BLANK secrets — they document the required keys. Anything carrying a real
# value stays out of git: `.env` (local overrides) and `.env.development`,
# which holds working local credentials.
.env
.env.development
.env.development.local
.env.test.local
.env.production.local
.env.local

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
