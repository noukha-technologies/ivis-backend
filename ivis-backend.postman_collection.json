{
  "info": {
    "name": "IVIS Backend API",
    "description": "Complete API collection for the IVIS backend (NestJS). Base path: api/ivis/v1.\n\nUsage:\n1. Set the `base_url` variable (default http://localhost:3000/api/ivis/v1).\n2. Run Auth > Login — the access & refresh tokens are saved automatically to collection variables.\n3. All protected requests use Bearer {{access_token}} via collection-level auth.\n\nNote: Most create/update bodies reference snowflake IDs (e.g. role_access_id, centre_id). Replace the placeholder IDs with real ones from the corresponding list endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{access_token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api/ivis/v1", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "refresh_token", "value": "", "type": "string" },
    { "key": "id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "App",
      "item": [
        {
          "name": "Health / Hello",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/", "host": ["{{base_url}}"], "path": [""] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const data = res.data || res;",
                  "if (data.accessToken) { pm.collectionVariables.set('access_token', data.accessToken); }",
                  "if (data.refreshToken) { pm.collectionVariables.set('refresh_token', data.refreshToken); }",
                  "pm.test('Login succeeded', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"P@ssw0rd123\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const data = res.data || res;",
                  "if (data.accessToken) { pm.collectionVariables.set('access_token', data.accessToken); }",
                  "if (data.refreshToken) { pm.collectionVariables.set('refresh_token', data.refreshToken); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/refresh", "host": ["{{base_url}}"], "path": ["auth", "refresh"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
