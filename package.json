{
  "name": "ivis-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "cross-env NODE_ENV=development nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:bootstrap": "ts-node -r tsconfig-paths/register src/scripts/bootstrap-db.ts",
    "migration:create-schema": "cross-env RUN_CREATE_SCHEMA=true ts-node -r tsconfig-paths/register src/scripts/run-migration.ts CreateSchema1782000000000",
    "migration:alter": "cross-env RUN_ALTER_SCHEMA=true ts-node -r tsconfig-paths/register src/scripts/run-migration.ts AlterSchema1782010000000",
    "tajdeed:e2e": "ts-node -r tsconfig-paths/register src/scripts/tajdeed-e2e.ts",
    "migration:wipe": "cross-env ALLOW_DATA_WIPE=true ts-node -r tsconfig-paths/register src/scripts/run-migration.ts WipeData1782020000000",
    "migration:wipe-transactions": "cross-env ALLOW_DATA_WIPE=true ts-node -r tsconfig-paths/register src/scripts/run-migration.ts WipeTransactions1782030000000",
    "onboarding:super-admin": "ts-node -r tsconfig-paths/register src/scripts/onboard-super-admin.ts",
    "env:check": "ts-node -r tsconfig-paths/register src/scripts/check-env.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.3",
    "@nestjs/typeorm": "^11.0.1",
    "@nestjs/websockets": "^11.1.27",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "bowser": "^2.14.1",
    "busboy": "^1.6.0",
    "chalk": "^4.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fast-xml-parser": "^5.9.3",
    "ftp": "^0.3.10",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^6.0.0",
    "nest-winston": "^1.10.2",
    "pg": "^8.21.0",
    "ping": "^1.0.0",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.2",
    "snowflakify": "^1.0.7",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^7.0.0",
    "typeorm": "^1.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.6",
    "@types/ftp": "^0.3.36",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/ping": "^0.4.4",
    "@types/supertest": "^7.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^16.6.1",
    "erdia": "^3.7.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
